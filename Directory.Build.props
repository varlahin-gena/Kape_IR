<Project>
  <PropertyGroup>
    <KapePackVersion>1.8.8</KapePackVersion>
    <Version>$(KapePackVersion)</Version>
    <AssemblyVersion>1.8.8.0</AssemblyVersion>
    <FileVersion>1.8.8.0</FileVersion>
    <InformationalVersion>$(KapePackVersion)</InformationalVersion>
    <Product>KapeIR</Product>
    <AssemblyTitle>KapeIR</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- WPF SDK omits System.IO from default ImplicitUsings; keep Path/File/Directory available. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
