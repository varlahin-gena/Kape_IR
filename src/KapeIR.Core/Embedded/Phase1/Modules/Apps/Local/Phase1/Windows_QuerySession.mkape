Description: Active sessions (query session or PowerShell fallback for Windows Home)
Category: LiveResponse
Author: KapeIR / IR Phase1
Version: 1.1
Id: a1b2c3d4-e5f6-7890-ab12-cd34ef567803
ExportFormat: txt
Processors:
    -
        Executable: C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
        CommandLine: -NoProfile -ExecutionPolicy Bypass -File "%kapeDirectory%\Modules\bin\Get-Sessions.ps1" -OutputFile "%destinationDirectory%\query_session.txt"
        ExportFormat: txt
        ExportFile: query_session.txt

# Documentation
# https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/query-session
# Windows Home often has no query.exe — script falls back to process session map / qwinsta.
