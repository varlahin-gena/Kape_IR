Description: 'Volatility 3 offline — windows.psscan'
Category: Memory
Author: KapeIR / digital-forensics
Version: 1.0
Id: b1c2d3e4-f5a6-4789-8abc-111111111003
BinaryUrl: https://github.com/volatilityfoundation/volatility3/releases/download/v2.28.0/volatility3-win-exes-2.28.0.zip
ExportFormat: csv
Processors:
    -
        Executable: C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
        CommandLine: -NoProfile -ExecutionPolicy Bypass -File "%kapeDirectory%\Modules\bin\Invoke-Volatility3Plugin.ps1" -SourceDirectory "%sourceDirectory%" -DestinationDirectory "%destinationDirectory%" -VolExe "%kapeDirectory%\Modules\bin\volatility3\vol.exe" -Plugin windows.psscan -OutputFileName volatility3_psscan.csv -Renderer csv
        ExportFormat: csv

# Documentation
# Offline only (lab). Finds memory.raw or memory.dmp under msource (root or recursive).
# Setup: Modules\bin\volatility3\README.txt
# https://github.com/volatilityfoundation/volatility3
