<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
      <TargetFramework>net8.0</TargetFramework>
      <RootNamespace>KapeIR.Core</RootNamespace>
      <AssemblyName>KapeIR.Core</AssemblyName>
    </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KapeIR.Builder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Help\*.md" />
    <!-- KapeIR catalog payload: Phase1 + Hayabusa v41 (seeded into any KAPE root). -->
    <EmbeddedResource Include="Embedded\Phase1\**\*"
                      LogicalName="Phase1\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
