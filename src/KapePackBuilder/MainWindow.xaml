<Window x:Class="KapePackBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KapePackBuilder.ViewModels"
        Title="Kape_IR"
        Height="860" Width="1280"
        MinHeight="700" MinWidth="1100"
        Background="#1e1e1e"
        Foreground="#e8e8e8"
        Icon="pack://application:,,,/app.ico"
        Loaded="Window_Loaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#e8e8e8"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2b2b2b"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Background" Value="#3a3a3a"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#555"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#111"/>
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="#2b2b2b"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#333337"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0e639c"/>
                <Setter Property="Foreground" Value="#ffffff"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#1177bb"/>
                <Setter Property="Foreground" Value="#ffffff"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="#2b2b2b"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#0e639c"/>
          <Setter Property="Foreground" Value="#ffffff"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#333337"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="#252526" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Корень KAPE:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Column="1" Text="{Binding KapeRoot, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseKapeRootCommand}"/>
        <Button Grid.Column="3" Content="Перечитать каталог" Command="{Binding ReloadCatalogCommand}"
                ToolTip="Пересканировать локальные Targets/Modules на диске (без сети)"/>
        <Button Grid.Column="4" Content="Убрать дубликаты" Command="{Binding FixNameCollisionsCommand}"
                ToolTip="KAPE требует уникальные имена .tkape/.mkape. Лишние копии → PackBuilder\name_collisions"/>
        <Button Grid.Column="5" Content="Обновить с GitHub…" Command="{Binding UpdateFromGitHubCommand}"
                Background="#2d6a4f" Foreground="White"
                ToolTip="Проверка и обновление: KapeFiles (Targets/Modules), EZ Tools (Modules\bin), Chainsaw (Modules\bin\chainsaw)"/>
        <Button Grid.Column="6" Content="Журнал" Command="{Binding OpenAppLogFolderCommand}"
                ToolTip="Открыть папку логов Pack Builder"/>
        <Button Grid.Column="7" Content="О программе" Command="{Binding ShowAboutCommand}"/>
        <Button Grid.Column="8" Content="Отмена" Command="{Binding CancelSyncCommand}"
                Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}"
                ToolTip="Отменить проверку/скачивание обновлений"/>
      </Grid>
    </Border>

    <!-- Status -->
    <Border DockPanel.Dock="Bottom" Background="#252526" Padding="12,6">
      <TextBlock Text="{Binding StatusText}"/>
    </Border>

    <!-- Body -->
    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>

      <TabControl Grid.Column="0" Background="#1e1e1e">
        <!-- Targets -->
        <TabItem Header="Таргеты">
          <DockPanel Margin="6">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TargetSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск таргетов"/>
              <ComboBox Grid.Column="1" Margin="6,0,0,0"
                        ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding TargetFilter}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock Text="Клик по строке или галочка — в пакет. Выделение показывает сведения справа внизу."
                         Foreground="#999" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Снять все" Command="{Binding ClearTargetsCommand}"/>
              <Button DockPanel.Dock="Right" Content="Выбрать видимые" Command="{Binding CheckVisibleTargetsCommand}"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Документация" FontWeight="SemiBold" Margin="0,0,0,4"
                         Visibility="{Binding HasDocumentationLinks, Converter={StaticResource BoolToVis}}"/>
              <ScrollViewer DockPanel.Dock="Top" MaxHeight="72" Margin="0,0,0,6"
                            Visibility="{Binding HasDocumentationLinks, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding DocumentationLinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}"
                              Command="{Binding DataContext.OpenDocumentationLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Margin="0,0,0,2" Padding="4,1" HorizontalAlignment="Left"
                              Background="Transparent" BorderThickness="0" Foreground="#6cb6ff"
                              Cursor="Hand" ToolTip="Открыть в браузере"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBox Height="90" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       Text="{Binding DetailText}"/>
            </DockPanel>
            <ListView ItemsSource="{Binding TargetRows}"
                      SelectionChanged="TargetList_SelectionChanged"
                      PreviewMouseLeftButtonDown="TargetList_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="Catalog_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="40">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="TargetCheck_Changed" Unchecked="TargetCheck_Changed"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding DisplayName}" Width="220"/>
                  <GridViewColumn Header="Источник" DisplayMemberBinding="{Binding OriginLabel}" Width="90"/>
                  <GridViewColumn Header="Категория / путь" DisplayMemberBinding="{Binding Meta}" Width="280"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- Modules -->
        <TabItem Header="Модули">
          <DockPanel Margin="6">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding ModuleSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск модулей"/>
              <ComboBox Grid.Column="1" Margin="6,0,0,0"
                        ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding ModuleFilter}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock Text="Клик по строке или галочка — в пакет. «Подсказать» — парсеры под выбранные таргеты."
                         Foreground="#999" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Снять все" Command="{Binding ClearModulesCommand}"/>
              <Button DockPanel.Dock="Right" Content="Выбрать видимые" Command="{Binding CheckVisibleModulesCommand}"/>
              <Button DockPanel.Dock="Right" Content="Подсказать по таргетам" Command="{Binding SuggestModulesCommand}"
                      Background="#2d6a4f" Foreground="White"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Документация" FontWeight="SemiBold" Margin="0,0,0,4"
                         Visibility="{Binding HasDocumentationLinks, Converter={StaticResource BoolToVis}}"/>
              <ScrollViewer DockPanel.Dock="Top" MaxHeight="72" Margin="0,0,0,6"
                            Visibility="{Binding HasDocumentationLinks, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding DocumentationLinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}"
                              Command="{Binding DataContext.OpenDocumentationLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Margin="0,0,0,2" Padding="4,1" HorizontalAlignment="Left"
                              Background="Transparent" BorderThickness="0" Foreground="#6cb6ff"
                              Cursor="Hand" ToolTip="Открыть в браузере"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBox Height="90" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       Text="{Binding DetailText}"/>
            </DockPanel>
            <ListView ItemsSource="{Binding ModuleRows}"
                      SelectionChanged="ModuleList_SelectionChanged"
                      PreviewMouseLeftButtonDown="ModuleList_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="Module_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="40">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="ModuleCheck_Changed" Unchecked="ModuleCheck_Changed"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding DisplayName}" Width="220"/>
                  <GridViewColumn Header="Источник" DisplayMemberBinding="{Binding OriginLabel}" Width="90"/>
                  <GridViewColumn Header="Категория / путь" DisplayMemberBinding="{Binding Meta}" Width="280"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- Compound tree -->
        <TabItem Header="Дерево compound">
          <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#aaa" Margin="0,0,0,6"
                       Text="Переключатель «Таргеты / Модули» выбирает, какое дерево показывать. Compound отмечает все leaf. ⋆ — входит в несколько пакетов."/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TreeSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск в дереве"/>
              <CheckBox Grid.Column="1" Content="Только общие" IsChecked="{Binding TreeSharedOnly}"
                        VerticalAlignment="Center" Margin="8,0"
                        ToolTip="Показать только leaf, которые входят в несколько compound-пакетов (⋆). Узлы без пересечений скрываются."/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <RadioButton Content="Таргеты"
                             GroupName="TreeKind"
                             IsChecked="{Binding TreeIsTargets, Mode=TwoWay}"
                             Margin="0,0,10,0"
                             ToolTip="Дерево compound-таргетов (.tkape)"/>
                <RadioButton Content="Модули"
                             GroupName="TreeKind"
                             IsChecked="{Binding TreeIsModules, Mode=TwoWay}"
                             ToolTip="Дерево compound-модулей (.mkape)"/>
              </StackPanel>
              <Button Grid.Column="3" Content="Развернуть" Command="{Binding ExpandTreeCommand}"/>
              <Button Grid.Column="4" Content="Свернуть" Command="{Binding CollapseTreeCommand}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <Button Content="Добавить в пакет" Command="{Binding MergeTreeIntoPackageCommand}" Background="#1f6aa5" Foreground="White"/>
              <Button Content="Заменить пакет" Command="{Binding ReplacePackageFromTreeCommand}"/>
              <TextBlock Text="{Binding TreeStats}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
            <TreeView ItemsSource="{Binding TreeRoots}"
                      VirtualizingPanel.IsVirtualizing="True"
                      MouseDoubleClick="Tree_MouseDoubleClick">
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="TreeCheck_Changed" Unchecked="TreeCheck_Changed"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayName}" Margin="6,0,8,0"/>
                    <TextBlock Text="{Binding Badge}" Foreground="#9ad" FontSize="11"/>
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                  <Setter Property="Foreground" Value="#e8e8e8"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#0e639c"/>
                      <Setter Property="Foreground" Value="#ffffff"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#333337"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TreeView.ItemContainerStyle>
            </TreeView>
          </DockPanel>
        </TabItem>

        <!-- Existing packs -->
        <TabItem Header="Готовые пакеты">
          <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Compound-таргеты каталога. «Роль»: корневой = никуда не вложен; вложенный = входит в другой compound. «Используется в» — все родительские пакеты. «Детей» — прямые ссылки внутри. Загрузка одного compound в пакет; объединить несколько — «Дерево compound»."/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Загрузить выбранный" Command="{Binding LoadSelectedCompoundCommand}"/>
              <Button Content="Открыть package.json…" Command="{Binding OpenPackageJsonCommand}"/>
              <Button Content="Сохранить сессию" Command="{Binding SaveSessionCommand}"
                      ToolTip="Сохранить текущий пакет в PackBuilder\sessions"/>
              <Button Content="Загрузить сессию…" Command="{Binding LoadSessionCommand}"
                      ToolTip="Открыть ранее сохранённую сессию"/>
            </StackPanel>
            <ListView ItemsSource="{Binding ExistingPacks}"
                      SelectedItem="{Binding SelectedExisting}"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding DisplayName}" Width="180"/>
                  <GridViewColumn Header="Роль" DisplayMemberBinding="{Binding NestingRole}" Width="80"/>
                  <GridViewColumn Header="Детей" DisplayMemberBinding="{Binding ChildCount}" Width="50"/>
                  <GridViewColumn Header="Используется в" DisplayMemberBinding="{Binding UsedByDisplay}" Width="260"/>
                  <GridViewColumn Header="Источник" DisplayMemberBinding="{Binding OriginLabel}" Width="80"/>
                  <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Item.Description}" Width="280"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- Modules\bin utilities (parsers / live tools) -->
        <TabItem Header="Утилиты">
          <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#aaa" Margin="0,0,0,6"
                       Text="Утилиты из Modules\bin (EXE и корневые .ps1): парсеры EZ Tools, Chainsaw, winpmem и др. Нужны при сборке пакета с «Включить Modules\bin» и на цели при --module / Phase1. ★ — ключевой парсер triage. Правила Chainsaw .yml здесь не перечисляются."/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BinariesSummary}" TextWrapping="Wrap" Margin="0,0,0,6"
                       FontWeight="SemiBold"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding BinarySearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск по имени, пути, версии, product"/>
              <ComboBox Grid.Column="1" Margin="6,0,0,0"
                        ItemsSource="{Binding BinaryFilterOptions}"
                        SelectedItem="{Binding BinaryFilter}"/>
              <Button Grid.Column="2" Content="Обновить список" Command="{Binding ReloadBinariesCommand}"
                      ToolTip="Пересканировать Modules\bin"/>
              <Button Grid.Column="3" Content="Открыть папку" Command="{Binding OpenModulesBinFolderCommand}"
                      ToolTip="Открыть Modules\bin в Explorer"/>
            </Grid>
            <TextBox DockPanel.Dock="Bottom" Height="110" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                     Text="{Binding BinaryDetailText}"/>
            <ListView ItemsSource="{Binding BinaryRows}"
                      SelectedItem="{Binding SelectedBinary}"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="" DisplayMemberBinding="{Binding KeyMark}" Width="28"/>
                  <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="180"/>
                  <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding Category}" Width="100"/>
                  <GridViewColumn Header="Группа" DisplayMemberBinding="{Binding Group}" Width="140"/>
                  <GridViewColumn Header="Версия" DisplayMemberBinding="{Binding VersionDisplay}" Width="110"/>
                  <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeDisplay}" Width="80"/>
                  <GridViewColumn Header="Изменён" DisplayMemberBinding="{Binding ModifiedDisplay}" Width="120"/>
                  <GridViewColumn Header="Путь" DisplayMemberBinding="{Binding RelativePath}" Width="220"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
      </TabControl>

      <!-- Package panel -->
      <Border Grid.Column="2" Background="#252526" Padding="10" CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Пакет" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Имя"/>
            <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="Описание"/>
            <TextBox Text="{Binding PackageDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="Автор"/>
            <TextBox Text="{Binding PackageAuthor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="Версия"/>
            <TextBox Text="{Binding PackageVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="tsource"/>
            <TextBox Text="{Binding Tsource, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
              <CheckBox Content="Упаковать в ZIP" IsChecked="{Binding ZipOutput}"
                        ToolTip="Флаг KAPE --zip: архивировать собранные данные"/>
              <CheckBox Content="Теневые копии (VSS)" IsChecked="{Binding Vss}"
                        Margin="12,0,0,0"
                        ToolTip="Флаг KAPE --vss: сбор через Volume Shadow Copy"/>
            </StackPanel>
            <CheckBox Content="Двухфазный IR (volatile → disk)" IsChecked="{Binding TwoPhaseCollection}"
                      Margin="0,0,0,6"
                      ToolTip="Фаза 1: VolatileFirst (добавляется автоматически; Modules\bin с winpmem/парсерами кладётся в EXE). Фаза 2: выбранные таргеты + остальные модули."/>
            <TextBlock Text="Case ID (для CoC)" Opacity="0.85"/>
            <TextBox Text="{Binding CaseId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                     ToolTip="Идентификатор дела → chain_of_custody.txt на целевом хосте"/>
            <TextBlock Text="Выбранные таргеты" FontWeight="Bold"/>
            <TextBox Text="{Binding SelectedTargetsText}" IsReadOnly="True" Height="140" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
            <Button Content="Очистить таргеты" Command="{Binding ClearTargetsCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="Выбранные модули" FontWeight="Bold"/>
            <TextBox Text="{Binding SelectedModulesText}" IsReadOnly="True" Height="110" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="Подсказать по таргетам" Command="{Binding SuggestModulesCommand}"
                      Background="#2d6a4f" Foreground="White" Margin="0,0,8,0"/>
              <Button Content="Очистить модули" Command="{Binding ClearModulesCommand}"/>
            </StackPanel>
            <TextBlock Text="Заметки"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap"
                     AcceptsReturn="True" Margin="0,0,0,8"/>
            <CheckBox Content="Оставить ZIP" IsChecked="{Binding MakeZip}" Margin="0,0,0,10"
                      ToolTip="Помимо EXE сохранить ZIP-архив пакета (папка пакета не сохраняется)"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Новый пакет" Command="{Binding NewPackCommand}" Margin="0,0,4,0"/>
              <Button Grid.Column="1" Content="Превью cmd" Command="{Binding PreviewCommandCommand}" Margin="2,0"/>
              <Button Grid.Column="2" Content="Собрать автономный EXE" Command="{Binding BuildPackageCommand}"
                      Background="#1f6aa5" Foreground="White" Margin="4,0,4,0"
                      ToolTip="Один EXE: распаковка + kape.exe + таргеты/модули + запуск сбора"/>
              <Button Grid.Column="3" Content="Отмена" Command="{Binding CancelBuildCommand}"
                      Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"
                      ToolTip="Отменить текущую сборку пакета"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
