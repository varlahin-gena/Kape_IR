<Window x:Class="KapePackBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KapePackBuilder.ViewModels"
        Title="KAPE Pack Builder"
        Height="860" Width="1280"
        MinHeight="700" MinWidth="1100"
        Background="#1e1e1e"
        Foreground="#e8e8e8"
        Loaded="Window_Loaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#e8e8e8"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2b2b2b"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Background" Value="#3a3a3a"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#555"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#111"/>
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="#2b2b2b"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="#2b2b2b"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="#252526" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Корень KAPE:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Column="1" Text="{Binding KapeRoot, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseKapeRootCommand}"/>
        <Button Grid.Column="3" Content="Обновить" Command="{Binding ReloadCatalogCommand}"/>
        <Button Grid.Column="4" Content="Обновить с GitHub" Command="{Binding UpdateFromGitHubCommand}"
                Background="#2d6a4f" Foreground="White"/>
      </Grid>
    </Border>

    <!-- Status -->
    <Border DockPanel.Dock="Bottom" Background="#252526" Padding="12,6">
      <TextBlock Text="{Binding StatusText}"/>
    </Border>

    <!-- Body -->
    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>

      <TabControl Grid.Column="0" Background="#1e1e1e">
        <!-- Targets -->
        <TabItem Header="Таргеты">
          <DockPanel Margin="6">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TargetSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск таргетов"/>
              <ComboBox Grid.Column="1" Margin="6,0,0,0"
                        ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding TargetFilter}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock Text="Галочка — вкл/выкл. Двойной клик — сведения."
                         Foreground="#999" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Снять все" Command="{Binding ClearTargetsCommand}"/>
              <Button DockPanel.Dock="Right" Content="Выбрать видимые" Command="{Binding CheckVisibleTargetsCommand}"/>
            </DockPanel>
            <TextBox DockPanel.Dock="Bottom" Height="90" IsReadOnly="True" TextWrapping="Wrap"
                     Text="{Binding DetailText}" Margin="0,6,0,0"/>
            <ListView ItemsSource="{Binding TargetRows}"
                      MouseDoubleClick="Catalog_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="40">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="TargetCheck_Changed" Unchecked="TargetCheck_Changed"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding DisplayName}" Width="280"/>
                  <GridViewColumn Header="Категория / путь" DisplayMemberBinding="{Binding Meta}" Width="360"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- Modules -->
        <TabItem Header="Модули">
          <DockPanel Margin="6">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding ModuleSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск модулей"/>
              <ComboBox Grid.Column="1" Margin="6,0,0,0"
                        ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding ModuleFilter}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock Text="Галочка — вкл/выкл. «Подсказать» — парсеры под выбранные таргеты."
                         Foreground="#999" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Снять все" Command="{Binding ClearModulesCommand}"/>
              <Button DockPanel.Dock="Right" Content="Выбрать видимые" Command="{Binding CheckVisibleModulesCommand}"/>
              <Button DockPanel.Dock="Right" Content="Подсказать по таргетам" Command="{Binding SuggestModulesCommand}"
                      Background="#2d6a4f" Foreground="White"/>
            </DockPanel>
            <ListView ItemsSource="{Binding ModuleRows}"
                      MouseDoubleClick="Module_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="40">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="ModuleCheck_Changed" Unchecked="ModuleCheck_Changed"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding DisplayName}" Width="280"/>
                  <GridViewColumn Header="Категория / путь" DisplayMemberBinding="{Binding Meta}" Width="360"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- Compound tree -->
        <TabItem Header="Дерево compound">
          <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#aaa" Margin="0,0,0,6"
                       Text="Дерево синхронизируется с таргетами/модулями. Compound выбирает все листовые элементы. ⋆ — входит в несколько пакетов."/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TreeSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск в дереве"/>
              <CheckBox Grid.Column="1" Content="Только общие" IsChecked="{Binding TreeSharedOnly}" VerticalAlignment="Center" Margin="8,0"/>
              <CheckBox Grid.Column="2" Content="Дерево таргетов" IsChecked="{Binding TreeIsTargets}" VerticalAlignment="Center"/>
              <Button Grid.Column="3" Content="Развернуть" Command="{Binding ExpandTreeCommand}"/>
              <Button Grid.Column="4" Content="Свернуть" Command="{Binding CollapseTreeCommand}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <Button Content="Добавить в пакет" Command="{Binding MergeTreeIntoPackageCommand}" Background="#1f6aa5" Foreground="White"/>
              <Button Content="Заменить пакет" Command="{Binding ReplacePackageFromTreeCommand}"/>
              <TextBlock Text="{Binding TreeStats}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
            <TreeView ItemsSource="{Binding TreeRoots}"
                      VirtualizingPanel.IsVirtualizing="True"
                      MouseDoubleClick="Tree_MouseDoubleClick">
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="TreeCheck_Changed" Unchecked="TreeCheck_Changed"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayName}" Margin="6,0,8,0"/>
                    <TextBlock Text="{Binding Badge}" Foreground="#9ad" FontSize="11"/>
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                  <Setter Property="Foreground" Value="#e8e8e8"/>
                </Style>
              </TreeView.ItemContainerStyle>
            </TreeView>
          </DockPanel>
        </TabItem>

        <!-- Existing packs -->
        <TabItem Header="Готовые пакеты">
          <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Загрузить один compound в пакет (галочки синхронизируются). Чтобы объединить несколько — используйте «Дерево compound»."/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Загрузить выбранный" Command="{Binding LoadSelectedCompoundCommand}"/>
              <Button Content="Открыть package.json…" Command="{Binding OpenPackageJsonCommand}"/>
            </StackPanel>
            <ListView ItemsSource="{Binding ExistingPacks}"
                      SelectedItem="{Binding SelectedExisting}"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding DisplayName}" Width="220"/>
                  <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Item.Description}" Width="420"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
      </TabControl>

      <!-- Package panel -->
      <Border Grid.Column="2" Background="#252526" Padding="10" CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Пакет" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Имя"/>
            <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="Описание"/>
            <TextBox Text="{Binding PackageDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="Автор"/>
            <TextBox Text="{Binding PackageAuthor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="Версия"/>
            <TextBox Text="{Binding PackageVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <TextBlock Text="tsource"/>
            <TextBox Text="{Binding Tsource, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
              <CheckBox Content="--zip" IsChecked="{Binding ZipOutput}"/>
              <CheckBox Content="--flush" IsChecked="{Binding Flush}"/>
              <CheckBox Content="--vss" IsChecked="{Binding Vss}"/>
            </StackPanel>
            <TextBlock Text="Выбранные таргеты" FontWeight="Bold"/>
            <TextBox Text="{Binding SelectedTargetsText}" IsReadOnly="True" Height="140" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
            <Button Content="Очистить таргеты" Command="{Binding ClearTargetsCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="Выбранные модули" FontWeight="Bold"/>
            <TextBox Text="{Binding SelectedModulesText}" IsReadOnly="True" Height="110" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="Подсказать по таргетам" Command="{Binding SuggestModulesCommand}"
                      Background="#2d6a4f" Foreground="White" Margin="0,0,8,0"/>
              <Button Content="Очистить модули" Command="{Binding ClearModulesCommand}"/>
            </StackPanel>
            <TextBlock Text="Заметки"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap"
                     AcceptsReturn="True" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <CheckBox Content="Установить в KAPE" IsChecked="{Binding InstallIntoKape}"/>
              <CheckBox Content="ZIP-архив" IsChecked="{Binding MakeZip}"/>
              <CheckBox Content="Копировать зависимости" IsChecked="{Binding CopyDeps}"/>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Новый пакет" Command="{Binding NewPackCommand}" Margin="0,0,4,0"/>
              <Button Grid.Column="1" Content="Превью cmd" Command="{Binding PreviewCommandCommand}" Margin="2,0"/>
              <Button Grid.Column="2" Content="Собрать пакет" Command="{Binding BuildPackageCommand}"
                      Background="#1f6aa5" Foreground="White" Margin="4,0,0,0"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
