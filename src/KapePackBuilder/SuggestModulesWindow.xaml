<Window x:Class="KapePackBuilder.SuggestModulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подсказки модулей по таргетам"
        Height="560" Width="920"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.SurfaceApp}"
        Foreground="{StaticResource Brush.TextPrimary}"
        Icon="pack://application:,,,/app.ico">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
               Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,12"
               Text="Рекомендации по FileMask, связкам Windows (Prefetch→PECmd) и имени/описанию. EZTools предпочтительнее."/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="Новые" Click="SelectNew_Click"/>
        <Button Content="Все" Click="SelectAll_Click"/>
        <Button Content="Ничего" Click="SelectNone_Click" Margin="0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" Click="Cancel_Click" IsCancel="True"/>
        <Button Content="Добавить выбранные" Click="Apply_Click" IsDefault="True"
                Style="{StaticResource PrimaryButton}" Margin="0"/>
      </StackPanel>
    </DockPanel>

    <ListView ItemsSource="{Binding Rows}">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="36">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{Binding Name}"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Модуль" DisplayMemberBinding="{Binding Name}" Width="200"/>
          <GridViewColumn Header="Оценка / путь" DisplayMemberBinding="{Binding Meta}" Width="280"/>
          <GridViewColumn Header="Для таргетов" DisplayMemberBinding="{Binding Targets}" Width="160"/>
          <GridViewColumn Header="Причина" DisplayMemberBinding="{Binding Reason}" Width="180"/>
          <GridViewColumn Header="" DisplayMemberBinding="{Binding Already}" Width="110"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
