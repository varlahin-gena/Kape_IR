<Window x:Class="KapePackBuilder.SuggestModulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подсказки модулей по таргетам"
        Height="560" Width="920"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="#e8e8e8"
        Icon="pack://application:,,,/app.ico">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#e8e8e8"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Background" Value="#3a3a3a"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#555"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#e8e8e8"/>
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="#2b2b2b"/>
      <Setter Property="Foreground" Value="#e8e8e8"/>
      <Setter Property="BorderBrush" Value="#444"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#aaa" Margin="0,0,0,10"
               Text="Рекомендации по совпадению FileMask, известным связкам Windows (например Prefetch→PECmd) и имени/описанию. Модули EZTools предпочтительнее."/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="Новые" Click="SelectNew_Click"/>
        <Button Content="Все" Click="SelectAll_Click"/>
        <Button Content="Ничего" Click="SelectNone_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" Click="Cancel_Click" IsCancel="True"/>
        <Button Content="Добавить выбранные" Click="Apply_Click" IsDefault="True"
                Background="#1f6aa5" Foreground="White"/>
      </StackPanel>
    </DockPanel>

    <ListView ItemsSource="{Binding Rows}">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="36">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Модуль" DisplayMemberBinding="{Binding Name}" Width="200"/>
          <GridViewColumn Header="Оценка / путь" DisplayMemberBinding="{Binding Meta}" Width="280"/>
          <GridViewColumn Header="Для таргетов" DisplayMemberBinding="{Binding Targets}" Width="160"/>
          <GridViewColumn Header="Причина" DisplayMemberBinding="{Binding Reason}" Width="180"/>
          <GridViewColumn Header="" DisplayMemberBinding="{Binding Already}" Width="110"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
