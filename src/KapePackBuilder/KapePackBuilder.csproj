<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <TargetFramework>net8.0-windows</TargetFramework>
      <UseWPF>true</UseWPF>
      <AssemblyName>KapePackBuilder</AssemblyName>
      <ApplicationIcon>app.ico</ApplicationIcon>
    </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KapePack.Core\KapePack.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Stub for CollectPack: embed once. Copy beside output for F5/debug, but do NOT
       bundle again into PublishSingleFile (that doubled ~70 MB in the deliverable). -->
  <ItemGroup>
    <None Include="..\..\tools\KapePackRunner.exe" Condition="Exists('..\..\tools\KapePackRunner.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>KapePackRunner.exe</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <EmbeddedResource Include="..\..\tools\KapePackRunner.exe" Condition="Exists('..\..\tools\KapePackRunner.exe')"
                      LogicalName="KapePackRunner.exe" />
  </ItemGroup>

</Project>
