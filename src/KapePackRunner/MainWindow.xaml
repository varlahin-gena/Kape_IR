<Window x:Class="KapeIR.Triage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KapeIR.Triage"
        Height="640" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.SurfaceApp}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/app.ico"
        Loaded="OnLoaded">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" Text="KapeIR.Triage" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="SubtitleText" Text="Автономный сбор артефактов"
                 Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Progress card -->
    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="StatusText" Text="Подготовка…" FontWeight="SemiBold"/>
          <ProgressBar x:Name="ProgressBar" Margin="0,8,0,0"
                       IsIndeterminate="True" Minimum="0" Maximum="100"/>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="PercentText" VerticalAlignment="Center"
                   Margin="16,0,0,0" Foreground="{StaticResource Brush.TextSecondary}"
                   FontFamily="Consolas"/>
      </Grid>
    </Border>

    <!-- Source card -->
    <Border x:Name="SourcePanel" Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12"
            Visibility="Collapsed">
      <StackPanel>
        <!-- Disk -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Диск:" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.TextSecondary}"
                     ToolTip="Том для --tsource / --msource"/>
          <ComboBox x:Name="DriveCombo" Grid.Column="1" VerticalAlignment="Center"
                    IsEditable="True" IsReadOnly="True" IsTextSearchEnabled="False"
                    StaysOpenOnEdit="False"
                    SelectionChanged="DriveCombo_SelectionChanged"
                    ToolTip="Диск-источник сбора">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- Results -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Результаты:" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.TextSecondary}"
                     ToolTip="Куда складывать RESULTS\&lt;hostname&gt;"/>
          <TextBox x:Name="ResultsBox" Grid.Column="1" VerticalAlignment="Center"
                   ToolTip="Папка, внутри которой будет RESULTS\&lt;hostname&gt;\…"/>
          <Button x:Name="BrowseResultsBtn" Grid.Column="3" Content="Обзор…" Margin="0"
                  Click="BrowseResults_Click"
                  ToolTip="Выбрать папку для результатов триажа"/>
        </Grid>

        <!-- Actions: Оценить + Primary Начать сбор -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="SimBtn" Grid.Column="1" Content="Оценить (--sim)" Click="Sim_Click"
                  Margin="0,0,8,0"
                  ToolTip="Посчитать файлы/объём без копирования (KAPE --sim)"/>
          <Button x:Name="StartBtn" Grid.Column="2" Content="Начать сбор" Click="Start_Click"
                  Style="{StaticResource PrimaryButton}" Margin="0" Padding="18,8"/>
        </Grid>

        <!-- Дополнительно: sim checkbox + TwoPhasePanel -->
        <Expander x:Name="AdvancedExpander" Header="Дополнительно" Margin="0,12,0,0" IsExpanded="False">
          <StackPanel Margin="0,10,0,0">
            <CheckBox x:Name="SimBeforeCheck" Content="Перед сбором сначала выполнить оценку (--sim)"
                      ToolTip="При «Начать сбор» сначала --sim, затем подтверждение полного копирования"/>

            <StackPanel x:Name="TwoPhasePanel" Margin="0,10,0,0" Visibility="Collapsed">
              <TextBlock Text="Двухфазный IR" FontWeight="SemiBold" Margin="0,0,0,6"
                         Foreground="{StaticResource Brush.TextSecondary}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Case ID:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <TextBox x:Name="CaseIdBox" Grid.Column="1"
                         ToolTip="Идентификатор дела для chain_of_custody.txt"/>
              </Grid>
              <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="SkipMemoryCheck" Content="Без memory dump" Margin="0,0,16,0"
                          ToolTip="Фаза 1: VolatileFirst_NoMemory (без WinPmem)"/>
                <CheckBox x:Name="Phase1OnlyCheck" Content="Только фаза 1" Margin="0,0,16,0"
                          Checked="PhaseOnly_Checked"
                          ToolTip="Только volatile"/>
                <CheckBox x:Name="Phase2OnlyCheck" Content="Только фаза 2"
                          Checked="PhaseOnly_Checked" ToolTip="Только disk triage"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <!-- Journal label -->
    <TextBlock Grid.Row="3" Text="Журнал"
               Foreground="{StaticResource Brush.TextSecondary}"
               Margin="0,0,0,6" FontSize="12"/>

    <!-- Log -->
    <Border Grid.Row="4" Background="{StaticResource Brush.LogBg}"
            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
            CornerRadius="8" Padding="2">
      <TextBox x:Name="LogBox"
               IsReadOnly="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               AcceptsReturn="True"
               BorderThickness="0"
               Background="Transparent"
               Foreground="{StaticResource Brush.TextSecondary}"
               CaretBrush="{StaticResource Brush.TextPrimary}"
               FontFamily="Consolas"
               FontSize="12"
               Padding="12"/>
    </Border>

    <!-- Footer -->
    <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
      <Button x:Name="OpenResultsBtn" Content="Открыть RESULTS" Click="OpenResults_Click"
              IsEnabled="False" DockPanel.Dock="Left"/>
      <Button x:Name="SaveLogBtn" Content="Сохранить лог…" Click="SaveLog_Click"
              IsEnabled="False" DockPanel.Dock="Left"/>
      <Button x:Name="CancelRunBtn" Content="Остановить" Click="CancelRun_Click"
              IsEnabled="False" DockPanel.Dock="Left"
              Style="{StaticResource DangerButton}"
              ToolTip="Прервать запущенный kape.exe"/>
      <Button x:Name="CloseBtn" Content="Закрыть" Click="Close_Click"
              DockPanel.Dock="Right" Margin="0" IsEnabled="False"/>
    </DockPanel>
  </Grid>
</Window>
