<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <TargetFramework>net8.0-windows</TargetFramework>
      <UseWPF>true</UseWPF>
      <RootNamespace>KapeIR.Builder</RootNamespace>
      <AssemblyName>KapeIR</AssemblyName>
      <ApplicationIcon>app.ico</ApplicationIcon>
    </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <ProjectReference Include="..\KapeIR.Core\KapeIR.Core.csproj" />
    <ProjectReference Include="..\KapeIR.Ui\KapeIR.Ui.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KapeIR.Builder.Tests" />
  </ItemGroup>

  <!-- Triage stub: embed once. Copy beside output for F5/debug, but do NOT
       bundle again into PublishSingleFile (that doubled ~70 MB in the deliverable). -->
  <ItemGroup>
    <None Include="..\..\tools\KapeIR.Triage.exe" Condition="Exists('..\..\tools\KapeIR.Triage.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>KapeIR.Triage.exe</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <EmbeddedResource Include="..\..\tools\KapeIR.Triage.exe" Condition="Exists('..\..\tools\KapeIR.Triage.exe')" LogicalName="KapeIR.Triage.exe" />
  </ItemGroup>

</Project>
