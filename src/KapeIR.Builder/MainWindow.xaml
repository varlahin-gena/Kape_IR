<Window x:Class="KapeIR.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KapeIR.Ui;assembly=KapeIR.Ui"
        Title="KapeIR"
        Height="860" Width="1280"
        MinHeight="700" MinWidth="1100"
        Background="{StaticResource Brush.SurfaceApp}"
        Foreground="{StaticResource Brush.TextPrimary}"
        Icon="pack://application:,,,/app.ico"
        AutomationProperties.Name="KapeIR"
        Loaded="Window_Loaded">
  <Window.Resources>
    <ui:BindingProxy x:Key="MainVmProxy" Data="{Binding}"/>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding BuildPackageCommand}"/>
    <KeyBinding Key="F5" Command="{Binding Catalog.ReloadCatalogCommand}"/>
  </Window.InputBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource Brush.SurfacePanel}" Padding="4,2"
          AutomationProperties.Name="Главное меню">
      <MenuItem Header="_Каталог" AutomationProperties.Name="Меню Каталог">
        <MenuItem Header="Перечитать каталог" Command="{Binding Catalog.ReloadCatalogCommand}" InputGestureText="F5"
                  AutomationProperties.Name="Перечитать каталог"/>
        <MenuItem Header="Обновить с GitHub…" Command="{Binding Sync.UpdateFromGitHubCommand}"
                  AutomationProperties.Name="Обновить с GitHub"/>
        <MenuItem Header="Убрать дубликаты" Command="{Binding Catalog.FixNameCollisionsCommand}"
                  AutomationProperties.Name="Убрать дубликаты имён"/>
      </MenuItem>
      <MenuItem Header="_Сборка" AutomationProperties.Name="Меню Сборка">
        <MenuItem Header="Новая сборка" Command="{Binding PackageEditor.NewPackCommand}"
                  AutomationProperties.Name="Новая сборка"/>
        <MenuItem Header="Сохранить сборку" Command="{Binding PackageEditor.SaveAssemblyCommand}"
                  AutomationProperties.Name="Сохранить сборку"/>
        <Separator/>
        <MenuItem Header="Собрать EXE" Command="{Binding BuildPackageCommand}" InputGestureText="Ctrl+B"
                  AutomationProperties.Name="Собрать EXE"/>
      </MenuItem>
      <MenuItem Header="_Справка" AutomationProperties.Name="Меню Справка">
        <MenuItem Header="Журнал" Command="{Binding OpenAppLogFolderCommand}"
                  AutomationProperties.Name="Открыть папку журнала"/>
        <MenuItem Header="Справка" Command="{Binding ShowOperatorHelpCommand}"
                  AutomationProperties.Name="Справка по системе"/>
        <MenuItem Header="О программе" Command="{Binding ShowAboutCommand}"
                  AutomationProperties.Name="О программе"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{StaticResource Brush.SurfacePanel}"
            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Корень KAPE" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="KapeRootBox" Grid.Column="1"
                 Text="{Binding KapeRoot, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 ToolTip="Папка с kape.exe, Targets и Modules"
                 AutomationProperties.Name="Корень KAPE"
                 AutomationProperties.HelpText="Папка с kape.exe, Targets и Modules"/>
        <Button Grid.Column="2" Content="Обзор…" Command="{Binding Catalog.BrowseKapeRootCommand}" Margin="0,0,8,0"
                AutomationProperties.Name="Обзор корня KAPE"
                AutomationProperties.HelpText="Выбрать папку установки KAPE"/>
        <Button Grid.Column="3" Content="Обновить с GitHub…" Command="{Binding Sync.UpdateFromGitHubCommand}"
                Margin="0,0,8,0"
                ToolTip="Скачать обновления Targets/Modules, EZ Tools, Chainsaw и Hayabusa с GitHub"
                AutomationProperties.Name="Обновить с GitHub"
                AutomationProperties.HelpText="Скачать обновления Targets, Modules, EZ Tools, Chainsaw и Hayabusa с GitHub"/>
        <Button Grid.Column="4" Content="Отмена" Command="{Binding Sync.CancelSyncCommand}"
                Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource DangerButton}" Margin="0"
                AutomationProperties.Name="Отменить обновление с GitHub"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.SurfacePanel}"
            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="12,8">
      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                 AutomationProperties.Name="Строка состояния"
                 AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.HelpText="{Binding StatusText}"/>
    </Border>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="2*" MinWidth="320"/>
      </Grid.ColumnDefinitions>

      <TabControl Grid.Column="0" Background="{StaticResource Brush.SurfaceApp}"
                  AutomationProperties.Name="Каталог Targets и Modules">
        <TabItem Header="Таргеты" AutomationProperties.Name="Вкладка Таргеты">
          <DockPanel Margin="8">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TargetSearchBox"
                       Text="{Binding Catalog.TargetSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск по имени (Ctrl+F)"
                       ui:Watermark.Text="Поиск по имени…"
                       AutomationProperties.Name="Поиск таргетов по имени"
                       AutomationProperties.HelpText="Поиск по имени таргета, Ctrl+F"/>
              <ComboBox Grid.Column="1" Margin="8,0,0,0"
                        ItemsSource="{Binding Catalog.FilterOptions}"
                        SelectedItem="{Binding Catalog.TargetFilter}"
                        AutomationProperties.Name="Фильтр таргетов"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Выбрать видимые" Command="{Binding Catalog.CheckVisibleTargetsCommand}" Margin="0"
                      AutomationProperties.Name="Выбрать видимые таргеты"/>
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="1" Margin="0,0,4,0"
                       Text="{Binding Catalog.TargetColFilterName, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Имя…" AutomationProperties.Name="Фильтр столбца Имя таргеты"/>
              <TextBox Grid.Column="2" Margin="0,0,4,0"
                       Text="{Binding Catalog.TargetColFilterOrigin, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Источник…" AutomationProperties.Name="Фильтр столбца Источник таргеты"/>
              <TextBox Grid.Column="3"
                       Text="{Binding Catalog.TargetColFilterMeta, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Категория / путь…" AutomationProperties.Name="Фильтр столбца Мета таргеты"/>
            </Grid>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Документация" FontWeight="SemiBold" Margin="0,0,0,4"
                         Visibility="{Binding Catalog.HasDocumentationLinks, Converter={StaticResource BoolToVis}}"/>
              <ScrollViewer DockPanel.Dock="Top" MaxHeight="72" Margin="0,0,0,6"
                            Visibility="{Binding Catalog.HasDocumentationLinks, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Catalog.DocumentationLinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Style="{StaticResource LinkButton}"
                              Command="{Binding DataContext.Catalog.OpenDocumentationLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" ToolTip="Открыть в браузере"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBox Height="88" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       Text="{Binding Catalog.DetailText}" Background="{StaticResource Brush.SurfacePanel}"/>
            </DockPanel>
            <ListView x:Name="TargetList" ItemsSource="{Binding Catalog.TargetRows}"
                      SelectionChanged="TargetList_SelectionChanged"
                      PreviewMouseLeftButtonDown="TargetList_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="Catalog_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True"
                      AutomationProperties.Name="Список таргетов">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="40">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="TargetCheck_Changed" Unchecked="TargetCheck_Changed"
                                  AutomationProperties.Name="{Binding DisplayName}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Width="220">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.TargetSortNameHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortTargetsCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Name"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding OriginLabel}" Width="90">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.TargetSortOriginHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortTargetsCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Origin"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding Meta}" Width="280">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.TargetSortMetaHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortTargetsCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Meta"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <TabItem Header="Модули" AutomationProperties.Name="Вкладка Модули">
          <DockPanel Margin="8">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ModuleSearchBox"
                       Text="{Binding Catalog.ModuleSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск по имени"
                       ui:Watermark.Text="Поиск по имени…"
                       AutomationProperties.Name="Поиск модулей по имени"
                       AutomationProperties.HelpText="Поиск модулей по имени"/>
              <ComboBox Grid.Column="1" Margin="8,0,0,0"
                        ItemsSource="{Binding Catalog.ModuleFilterOptions}"
                        SelectedItem="{Binding Catalog.ModuleFilter}"
                        AutomationProperties.Name="Фильтр модулей"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Проверить bin" Command="{Binding Catalog.CheckModuleBinariesCommand}"
                        ToolTip="Сверить выбранные .mkape (или весь каталог) с Modules\bin"
                        AutomationProperties.Name="Проверить бинарники модулей"
                        AutomationProperties.HelpText="Сверить .mkape с Modules\bin"/>
                <Button Content="Подсказать" Command="{Binding Catalog.SuggestModulesCommand}"
                        ToolTip="Подобрать парсеры под выбранные таргеты"
                        AutomationProperties.Name="Подсказать модули"
                        AutomationProperties.HelpText="Подобрать парсеры под выбранные таргеты"/>
                <Button Content="Выбрать видимые" Command="{Binding Catalog.CheckVisibleModulesCommand}" Margin="0"
                        AutomationProperties.Name="Выбрать видимые модули"/>
              </StackPanel>
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="2" Margin="0,0,4,0"
                       Text="{Binding Catalog.ModuleColFilterName, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Имя…" AutomationProperties.Name="Фильтр столбца Имя модули"/>
              <TextBox Grid.Column="3" Margin="0,0,4,0"
                       Text="{Binding Catalog.ModuleColFilterOrigin, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Источник…" AutomationProperties.Name="Фильтр столбца Источник модули"/>
              <TextBox Grid.Column="1" Margin="0,0,4,0"
                       Text="{Binding Catalog.ModuleColFilterBin, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Bin…" ToolTip="✓ / ~ / ✗ / —"
                       AutomationProperties.Name="Фильтр столбца Bin модули"/>
              <TextBox Grid.Column="4"
                       Text="{Binding Catalog.ModuleColFilterMeta, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Категория / путь…" AutomationProperties.Name="Фильтр столбца Мета модули"/>
            </Grid>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Документация" FontWeight="SemiBold" Margin="0,0,0,4"
                         Visibility="{Binding Catalog.HasDocumentationLinks, Converter={StaticResource BoolToVis}}"/>
              <ScrollViewer DockPanel.Dock="Top" MaxHeight="72" Margin="0,0,0,6"
                            Visibility="{Binding Catalog.HasDocumentationLinks, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Catalog.DocumentationLinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Style="{StaticResource LinkButton}"
                              Command="{Binding DataContext.Catalog.OpenDocumentationLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" ToolTip="Открыть в браузере"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBox Height="88" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       Text="{Binding Catalog.DetailText}" Background="{StaticResource Brush.SurfacePanel}"/>
            </DockPanel>
            <ListView ItemsSource="{Binding Catalog.ModuleRows}"
                      SelectionChanged="ModuleList_SelectionChanged"
                      PreviewMouseLeftButtonDown="ModuleList_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="Module_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True"
                      AutomationProperties.Name="Список модулей">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="40">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="ModuleCheck_Changed" Unchecked="ModuleCheck_Changed"
                                  AutomationProperties.Name="{Binding DisplayName}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="48">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.ModuleSortBinHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortModulesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Bin"
                              ToolTip="Modules\bin: ✓ есть, ~ частично, ✗ нет, — sync"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding BinDisplay}" ToolTip="{Binding BinTooltip}"
                                   HorizontalAlignment="Center"
                                   AutomationProperties.Name="{Binding BinTooltip}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Width="200">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.ModuleSortNameHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortModulesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Name"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding OriginLabel}" Width="80">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.ModuleSortOriginHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortModulesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Origin"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding Meta}" Width="280">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.ModuleSortMetaHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortModulesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Meta"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <TabItem Header="Дерево compound" AutomationProperties.Name="Вкладка Дерево compound">
          <DockPanel Margin="8">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Catalog.TreeSearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск в дереве"
                       ui:Watermark.Text="Поиск в дереве…"
                       AutomationProperties.Name="Поиск в дереве compound"/>
              <CheckBox Grid.Column="1" Content="Только общие" IsChecked="{Binding Catalog.TreeSharedOnly}"
                        VerticalAlignment="Center" Margin="8,0"
                        AutomationProperties.Name="Только общие элементы дерева"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <RadioButton Content="Таргеты" GroupName="TreeKind"
                             IsChecked="{Binding Catalog.TreeIsTargets, Mode=TwoWay}" Margin="0,0,10,0"
                             AutomationProperties.Name="Дерево таргетов"/>
                <RadioButton Content="Модули" GroupName="TreeKind"
                             IsChecked="{Binding Catalog.TreeIsModules, Mode=TwoWay}"
                             AutomationProperties.Name="Дерево модулей"/>
              </StackPanel>
            </Grid>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button Content="Добавить в сборку" Command="{Binding Catalog.MergeTreeIntoPackageCommand}"
                      AutomationProperties.Name="Добавить выбранное из дерева в сборку"/>
              <Button Content="Заменить сборку" Command="{Binding Catalog.ReplacePackageFromTreeCommand}"
                      AutomationProperties.Name="Заменить сборку содержимым дерева"/>
              <TextBlock Text="{Binding Catalog.TreeStats}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                         VerticalAlignment="Center" Margin="12,0,0,0"
                         AutomationProperties.Name="{Binding Catalog.TreeStats}"/>
            </DockPanel>
            <TreeView ItemsSource="{Binding Catalog.TreeRoots}" VirtualizingPanel.IsVirtualizing="True"
                      MouseDoubleClick="Tree_MouseDoubleClick"
                      AutomationProperties.Name="Дерево compound">
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="TreeCheck_Changed" Unchecked="TreeCheck_Changed"
                              VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayName}"/>
                    <TextBlock Text="{Binding DisplayName}" Margin="6,0,8,0"/>
                    <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Brush.Link}" FontSize="11"/>
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
              </TreeView.ItemContainerStyle>
            </TreeView>
          </DockPanel>
        </TabItem>

        <TabItem Header="Готовые сборки" AutomationProperties.Name="Вкладка Готовые сборки">
          <DockPanel Margin="8">
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding Catalog.PackSearch, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск по имени"
                     ui:Watermark.Text="Поиск по имени…"
                     AutomationProperties.Name="Поиск готовых сборок по имени"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding Catalog.PackColFilterName, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Имя…" AutomationProperties.Name="Фильтр столбца Имя сборки"/>
              <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding Catalog.PackColFilterRole, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Роль…" AutomationProperties.Name="Фильтр столбца Роль"/>
              <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Catalog.PackColFilterChildren, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="N…" AutomationProperties.Name="Фильтр столбца Детей"/>
              <TextBox Grid.Column="3" Margin="0,0,4,0" Text="{Binding Catalog.PackColFilterUsedBy, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Используется…" AutomationProperties.Name="Фильтр столбца Используется в"/>
              <TextBox Grid.Column="4" Margin="0,0,4,0" Text="{Binding Catalog.PackColFilterOrigin, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Источник…" AutomationProperties.Name="Фильтр столбца Источник сборки"/>
              <TextBox Grid.Column="5" Text="{Binding Catalog.PackColFilterDescription, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Описание…" AutomationProperties.Name="Фильтр столбца Описание"/>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Загрузить" Command="{Binding Catalog.LoadSelectedCompoundCommand}" Margin="0,0,8,0"
                      AutomationProperties.Name="Загрузить выбранную готовую сборку"/>
              <Button Content="Сохранить" Command="{Binding PackageEditor.SaveAssemblyCommand}" Margin="0,0,8,0"
                      AutomationProperties.Name="Сохранить сборку в каталог"/>
              <Button Content="Удалить" Command="{Binding PackageEditor.DeleteAssemblyCommand}" Margin="0"
                      AutomationProperties.Name="Удалить локальную сборку"/>
            </StackPanel>
            <ListView ItemsSource="{Binding Catalog.ExistingPacks}" SelectedItem="{Binding PackageEditor.SelectedExisting}"
                      VirtualizingPanel.IsVirtualizing="True"
                      AutomationProperties.Name="Список готовых сборок">
              <ListView.View>
                <GridView>
                  <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Width="180">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.PackSortNameHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortPacksCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Name"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding NestingRole}" Width="80">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.PackSortRoleHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortPacksCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Role"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding ChildCount}" Width="50">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.PackSortChildrenHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortPacksCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Children"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding UsedByDisplay}" Width="260">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.PackSortUsedByHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortPacksCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="UsedBy"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding OriginLabel}" Width="80">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.PackSortOriginHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortPacksCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Origin"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding Item.Description}" Width="280">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Catalog.PackSortDescriptionHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Catalog.SortPacksCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Description"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <TabItem Header="Утилиты" AutomationProperties.Name="Вкладка Утилиты">
          <DockPanel Margin="8">
            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,8"
                       Text="Modules\bin: EZ Tools, Chainsaw, Hayabusa, winpmem, dfir_ntfs, RegRipper. ★ — ключевой парсер triage."/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Binaries.BinariesSummary}" Margin="0,0,0,8" FontWeight="SemiBold"
                       AutomationProperties.Name="{Binding Binaries.BinariesSummary}"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Binaries.BinarySearch, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Поиск по имени"
                       ui:Watermark.Text="Поиск по имени…"
                       AutomationProperties.Name="Поиск утилит по имени"
                       AutomationProperties.HelpText="Поиск утилит по имени"/>
              <ComboBox Grid.Column="1" Margin="8,0,0,0"
                        ItemsSource="{Binding Binaries.BinaryFilterOptions}" SelectedItem="{Binding Binaries.BinaryFilter}"
                        AutomationProperties.Name="Фильтр утилит"/>
              <Button Grid.Column="2" Content="Открыть папку" Command="{Binding Binaries.OpenModulesBinFolderCommand}" Margin="8,0,0,0"
                      AutomationProperties.Name="Открыть папку Modules bin"/>
            </Grid>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding Binaries.ColFilterName, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Имя…" AutomationProperties.Name="Фильтр столбца Имя утилиты"/>
              <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Binaries.ColFilterCategory, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Категория…" AutomationProperties.Name="Фильтр столбца Категория"/>
              <TextBox Grid.Column="3" Margin="0,0,4,0" Text="{Binding Binaries.ColFilterGroup, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Группа…" AutomationProperties.Name="Фильтр столбца Группа"/>
              <TextBox Grid.Column="4" Margin="0,0,4,0" Text="{Binding Binaries.ColFilterVersion, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Версия…" AutomationProperties.Name="Фильтр столбца Версия"/>
              <TextBox Grid.Column="5" Margin="0,0,4,0" Text="{Binding Binaries.ColFilterSize, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Размер…" AutomationProperties.Name="Фильтр столбца Размер"/>
              <TextBox Grid.Column="6" Margin="0,0,4,0" Text="{Binding Binaries.ColFilterModified, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Изменён…" AutomationProperties.Name="Фильтр столбца Изменён"/>
              <TextBox Grid.Column="7" Text="{Binding Binaries.ColFilterPath, UpdateSourceTrigger=PropertyChanged}"
                       ui:Watermark.Text="Путь…" AutomationProperties.Name="Фильтр столбца Путь"/>
            </Grid>
            <TextBox DockPanel.Dock="Bottom" Height="100" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                     Text="{Binding Binaries.BinaryDetailText}" Background="{StaticResource Brush.SurfacePanel}"/>
            <ListView ItemsSource="{Binding Binaries.BinaryRows}" SelectedItem="{Binding Binaries.SelectedBinary}"
                      VirtualizingPanel.IsVirtualizing="True"
                      AutomationProperties.Name="Список утилит Modules bin">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="" Width="28">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding KeyMark}" ToolTip="Ключевой парсер triage"
                                   AutomationProperties.Name="{Binding Name}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding Name}" Width="180">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Binaries.SortNameHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Binaries.SortBinariesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Name"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding Category}" Width="100">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Binaries.SortCategoryHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Binaries.SortBinariesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Category"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding Group}" Width="140">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Binaries.SortGroupHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Binaries.SortBinariesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Group"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding VersionDisplay}" Width="110">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Binaries.SortVersionHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Binaries.SortBinariesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Version"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding SizeDisplay}" Width="80">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Binaries.SortSizeHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Binaries.SortBinariesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Size"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding ModifiedDisplay}" Width="120">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Binaries.SortModifiedHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Binaries.SortBinariesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Modified"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                  <GridViewColumn DisplayMemberBinding="{Binding RelativePath}" Width="220">
                    <GridViewColumn.Header>
                      <Button Style="{StaticResource ColumnSortHeaderButton}"
                              Content="{Binding Data.Binaries.SortPathHeader, Source={StaticResource MainVmProxy}}"
                              Command="{Binding Data.Binaries.SortBinariesCommand, Source={StaticResource MainVmProxy}}"
                              CommandParameter="Path"/>
                    </GridViewColumn.Header>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
      </TabControl>

      <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0"
              AutomationProperties.Name="Редактор сборки">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="14,12,14,8"
                  BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Сборка" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding PackageEditor.PackageCompositionSummary}"
                         Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                         VerticalAlignment="Center" Margin="12,0,0,0"
                         AutomationProperties.Name="{Binding PackageEditor.PackageCompositionSummary}"/>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Padding="12,10"
                  Background="{StaticResource Brush.SurfacePanel}"
                  BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Новый" Command="{Binding PackageEditor.NewPackCommand}" Margin="0,0,8,0"
                      ToolTip="Очистить сборку и начать заново"
                      AutomationProperties.Name="Новая сборка"
                      AutomationProperties.HelpText="Очистить сборку и начать заново"/>
              <Button Grid.Column="1" Content="Собрать EXE" Command="{Binding BuildPackageCommand}"
                      Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                      ToolTip="Собрать автономный полевой EXE (Ctrl+B)"
                      AutomationProperties.Name="Собрать EXE"
                      AutomationProperties.HelpText="Собрать автономный полевой EXE, Ctrl+B"/>
              <Button Grid.Column="2" Content="Отмена" Command="{Binding CancelBuildCommand}"
                      Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"
                      Style="{StaticResource DangerButton}" Margin="0"
                      AutomationProperties.Name="Отменить сборку"/>
            </Grid>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
            <StackPanel>
              <Expander Header="Метаданные" IsExpanded="True" Margin="0,0,0,4">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="Имя" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                  <TextBox Text="{Binding PackageEditor.PackageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                           AutomationProperties.Name="Имя сборки"/>
                  <TextBlock Text="Описание" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                  <TextBox Text="{Binding PackageEditor.PackageDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                           AutomationProperties.Name="Описание сборки"/>
                  <TextBlock Text="Автор" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                  <TextBox Text="{Binding PackageEditor.PackageAuthor, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                           AutomationProperties.Name="Автор сборки"/>
                  <TextBlock Text="Версия" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                  <TextBox Text="{Binding PackageEditor.PackageVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"
                           AutomationProperties.Name="Версия сборки"/>
                </StackPanel>
              </Expander>

              <Expander Header="Сбор" IsExpanded="True" Margin="0,0,0,4"
                        AutomationProperties.Name="Параметры сбора">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="Диск-источник" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                  <TextBox Text="{Binding PackageEditor.Tsource, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                           ToolTip="Том на целевой системе, с которого собирать артефакты (например C:)"
                           AutomationProperties.Name="Диск-источник"
                           AutomationProperties.HelpText="Том на целевой системе для сбора"/>
                  <CheckBox Content="Теневые копии" IsChecked="{Binding PackageEditor.Vss}"
                            Margin="0,0,0,8"
                            ToolTip="Читать файлы через Volume Shadow Copy, если доступно"
                            AutomationProperties.Name="Теневые копии"
                            AutomationProperties.HelpText="Читать через Volume Shadow Copy"/>
                  <CheckBox Content="Двухфазный IR (volatile → disk)" IsChecked="{Binding PackageEditor.TwoPhaseCollection}"
                            Margin="0,0,0,8"
                            ToolTip="Сначала оперативный сбор, затем дисковый триаж"
                            AutomationProperties.Name="Двухфазный IR"
                            AutomationProperties.HelpText="Сначала volatile, затем disk"/>
                  <TextBlock Text="Case ID" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                  <TextBox Text="{Binding PackageEditor.CaseId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"
                           ui:Watermark.Text="INC-2026-0142"
                           ToolTip="Идентификатор дела для chain of custody"
                           AutomationProperties.Name="Case ID"
                           AutomationProperties.HelpText="Идентификатор дела для chain of custody"/>
                </StackPanel>
              </Expander>

              <Expander Header="Состав" IsExpanded="True" Margin="0,0,0,4">
                <StackPanel Margin="0,8,0,0">
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Таргеты" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding Catalog.ClearTargetsCommand}"
                            Margin="0" Padding="8,4" MinHeight="26"/>
                  </DockPanel>
                  <TextBox Text="{Binding PackageEditor.SelectedTargetsText}" IsReadOnly="True" Height="100"
                           TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           Margin="0,0,0,10" Background="{StaticResource Brush.SurfaceControl}"/>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Модули" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding Catalog.ClearModulesCommand}"
                            Margin="0" Padding="8,4" MinHeight="26"/>
                  </DockPanel>
                  <TextBox Text="{Binding PackageEditor.SelectedModulesText}" IsReadOnly="True" Height="90"
                           TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           Margin="0,0,0,4" Background="{StaticResource Brush.SurfaceControl}"/>
                </StackPanel>
              </Expander>

              <Expander Header="Заметки" IsExpanded="False">
                <TextBox Text="{Binding PackageEditor.Notes, UpdateSourceTrigger=PropertyChanged}" Height="72"
                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,8,0,0"/>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
