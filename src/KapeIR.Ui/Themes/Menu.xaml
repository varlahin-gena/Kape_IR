<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Dark.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Shared submenu popup chrome (hard-coded theme brushes — SystemColors overrides are ignored by Win11 templates) -->
  <Geometry x:Key="MenuCheckmarkGeometry">M 0,5.5 L 3,8.5 L 9.5,1.5 L 8,0 L 3,5.5 L 1.5,4 Z</Geometry>

  <ControlTemplate x:Key="MenuItem.TopLevelHeader" TargetType="MenuItem">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <Grid>
        <ContentPresenter ContentSource="Header"
                          RecognizesAccessKey="True"
                          VerticalAlignment="Center"
                          TextElement.Foreground="{TemplateBinding Foreground}"/>
        <Popup x:Name="PART_Popup"
               AllowsTransparency="True"
               Focusable="False"
               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
               Placement="Bottom"
               PopupAnimation="Fade"
               VerticalOffset="1">
          <Border Background="{StaticResource Brush.SurfaceControl}"
                  BorderBrush="{StaticResource Brush.BorderSubtle}"
                  BorderThickness="1"
                  Padding="2"
                  MinWidth="180">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceElevated}"/>
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceElevated}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="MenuItem.TopLevelItem" TargetType="MenuItem">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter ContentSource="Header"
                        RecognizesAccessKey="True"
                        VerticalAlignment="Center"
                        TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceElevated}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="MenuItem.SubmenuItem" TargetType="MenuItem">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            Padding="8,6"
            SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGT"/>
          <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>
        <Path x:Name="Glyph" Grid.Column="0"
              Data="{StaticResource MenuCheckmarkGeometry}"
              Fill="{StaticResource Brush.TextPrimary}"
              Visibility="Collapsed"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Width="10" Height="10" Stretch="Uniform"/>
        <ContentPresenter Grid.Column="1"
                          ContentSource="Header"
                          RecognizesAccessKey="True"
                          VerticalAlignment="Center"
                          Margin="4,0,12,0"
                          TextElement.Foreground="{TemplateBinding Foreground}"/>
        <TextBlock Grid.Column="2"
                   Text="{TemplateBinding InputGestureText}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   FontSize="11"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="MenuItem.SubmenuHeader" TargetType="MenuItem">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            Padding="8,6"
            SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>
        <ContentPresenter Grid.Column="1"
                          ContentSource="Header"
                          RecognizesAccessKey="True"
                          VerticalAlignment="Center"
                          Margin="4,0,8,0"
                          TextElement.Foreground="{TemplateBinding Foreground}"/>
        <Path Grid.Column="2"
              Data="M 0,0 L 4,3.5 L 0,7 Z"
              Fill="{StaticResource Brush.TextSecondary}"
              VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Popup x:Name="PART_Popup"
               AllowsTransparency="True"
               Focusable="False"
               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
               Placement="Right"
               HorizontalOffset="2"
               PopupAnimation="Fade">
          <Border Background="{StaticResource Brush.SurfaceControl}"
                  BorderBrush="{StaticResource Brush.BorderSubtle}"
                  BorderThickness="1"
                  Padding="2"
                  MinWidth="160">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="Menu">
    <Setter Property="Background" Value="{StaticResource Brush.SurfacePanel}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceControl}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource Brush.SurfaceControl}"
                  BorderBrush="{StaticResource Brush.BorderSubtle}"
                  BorderThickness="1"
                  Padding="2">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template" Value="{StaticResource MenuItem.SubmenuItem}"/>
    <Style.Triggers>
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template" Value="{StaticResource MenuItem.TopLevelHeader}"/>
      </Trigger>
      <Trigger Property="Role" Value="TopLevelItem">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template" Value="{StaticResource MenuItem.TopLevelItem}"/>
      </Trigger>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter Property="Template" Value="{StaticResource MenuItem.SubmenuHeader}"/>
      </Trigger>
      <Trigger Property="Role" Value="SubmenuItem">
        <Setter Property="Template" Value="{StaticResource MenuItem.SubmenuItem}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Margin" Value="6,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="4,2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
