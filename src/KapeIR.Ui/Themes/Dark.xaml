<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces: field IR dark, colder than GitHub-green template -->
  <Color x:Key="Color.SurfaceApp">#FF0B1220</Color>
  <Color x:Key="Color.SurfacePanel">#FF121A2B</Color>
  <Color x:Key="Color.SurfaceControl">#FF1A2438</Color>
  <Color x:Key="Color.SurfaceElevated">#FF243049</Color>
  <Color x:Key="Color.BorderSubtle">#FF2A3A55</Color>
  <Color x:Key="Color.TextPrimary">#FFE8EEF7</Color>
  <Color x:Key="Color.TextSecondary">#FF8B9BB4</Color>
  <!-- Cold blue accent (shared Builder + Triage) -->
  <Color x:Key="Color.Accent">#FF3B82F6</Color>
  <Color x:Key="Color.AccentHover">#FF60A5FA</Color>
  <Color x:Key="Color.AccentMuted">#FF1E3A5F</Color>
  <Color x:Key="Color.Success">#FF2DD4BF</Color>
  <Color x:Key="Color.Danger">#FFF85149</Color>
  <Color x:Key="Color.Link">#FF7DD3FC</Color>
  <!-- Keyboard focus ring: light enough on Accent/Danger fills and dark surfaces -->
  <Color x:Key="Color.FocusRing">#FFE8EEF7</Color>
  <Color x:Key="Color.Selection">#FF1E3A5F</Color>
  <Color x:Key="Color.RowHover">#FF243049</Color>
  <Color x:Key="Color.LogBg">#FF060A12</Color>

  <SolidColorBrush x:Key="Brush.SurfaceApp" Color="{StaticResource Color.SurfaceApp}"/>
  <SolidColorBrush x:Key="Brush.SurfacePanel" Color="{StaticResource Color.SurfacePanel}"/>
  <SolidColorBrush x:Key="Brush.SurfaceControl" Color="{StaticResource Color.SurfaceControl}"/>
  <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}"/>
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}"/>
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
  <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}"/>
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Link" Color="{StaticResource Color.Link}"/>
  <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}"/>
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}"/>
  <SolidColorBrush x:Key="Brush.LogBg" Color="{StaticResource Color.LogBg}"/>

  <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
  <CornerRadius x:Key="Radius.Md">8</CornerRadius>
  <Thickness x:Key="Pad.Control">10,7</Thickness>

</ResourceDictionary>
