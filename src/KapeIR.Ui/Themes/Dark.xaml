<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Color.SurfaceApp">#FF0F1419</Color>
  <Color x:Key="Color.SurfacePanel">#FF161B22</Color>
  <Color x:Key="Color.SurfaceControl">#FF21262D</Color>
  <Color x:Key="Color.SurfaceElevated">#FF30363D</Color>
  <Color x:Key="Color.BorderSubtle">#FF30363D</Color>
  <Color x:Key="Color.TextPrimary">#FFE6EDF3</Color>
  <Color x:Key="Color.TextSecondary">#FF8B949E</Color>
  <Color x:Key="Color.Accent">#FF2EA043</Color>
  <Color x:Key="Color.AccentHover">#FF3FB950</Color>
  <Color x:Key="Color.AccentMuted">#FF1F6A5A</Color>
  <Color x:Key="Color.Danger">#FFF85149</Color>
  <Color x:Key="Color.Link">#FF58A6FF</Color>
  <Color x:Key="Color.Selection">#FF1F6A5A</Color>
  <Color x:Key="Color.RowHover">#FF30363D</Color>
  <Color x:Key="Color.LogBg">#FF010409</Color>

  <SolidColorBrush x:Key="Brush.SurfaceApp" Color="{StaticResource Color.SurfaceApp}"/>
  <SolidColorBrush x:Key="Brush.SurfacePanel" Color="{StaticResource Color.SurfacePanel}"/>
  <SolidColorBrush x:Key="Brush.SurfaceControl" Color="{StaticResource Color.SurfaceControl}"/>
  <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}"/>
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}"/>
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
  <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Link" Color="{StaticResource Color.Link}"/>
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}"/>
  <SolidColorBrush x:Key="Brush.LogBg" Color="{StaticResource Color.LogBg}"/>

  <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
  <CornerRadius x:Key="Radius.Md">8</CornerRadius>
  <Thickness x:Key="Pad.Control">10,7</Thickness>

</ResourceDictionary>
