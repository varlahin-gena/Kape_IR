<Window x:Class="KapeIR.Triage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KapeIR.Triage.ViewModels"
        xmlns:ui="clr-namespace:KapeIR.Ui;assembly=KapeIR.Ui"
        Title="{Binding WindowTitle}"
        Height="640" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.SurfaceApp}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/app.ico"
        AutomationProperties.Name="{Binding WindowTitle}"
        Loaded="OnLoaded">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12"
                AutomationProperties.Name="Сведения о пакете">
      <TextBlock Text="{Binding PackageTitle}" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Subtitle}"
                 Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12"
            AutomationProperties.Name="Ход сбора">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{Binding StatusText}"/>
          <ProgressBar Margin="0,8,0,0"
                       Minimum="0" Maximum="100"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       AutomationProperties.Name="Прогресс сбора"
                       AutomationProperties.HelpText="{Binding StatusText}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ProgressTone}" Value="{x:Static vm:ProgressTone.Success}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ProgressTone}" Value="{x:Static vm:ProgressTone.Danger}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding PercentText}" VerticalAlignment="Center"
                   Margin="16,0,0,0" Foreground="{StaticResource Brush.TextSecondary}"
                   FontFamily="Consolas"
                   AutomationProperties.Name="{Binding PercentText}"/>
        <Button Grid.Column="2" Content="Остановить"
                Command="{Binding CancelRunCommand}"
                Style="{StaticResource DangerButton}"
                Margin="16,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                ToolTip="Прервать текущий сбор"
                AutomationProperties.Name="Остановить"
                AutomationProperties.HelpText="Прервать текущий сбор"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12"
            Visibility="{Binding IsSourceVisible, Converter={StaticResource BoolToVis}}"
            IsEnabled="{Binding IsSourceEnabled}"
            AutomationProperties.Name="Параметры сбора">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Диск:" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.TextSecondary}"
                     ToolTip="Том, с которого собирать артефакты"/>
          <ComboBox Grid.Column="1" VerticalAlignment="Center"
                    IsEditable="True" IsReadOnly="True" IsTextSearchEnabled="False"
                    StaysOpenOnEdit="False"
                    ItemsSource="{Binding Drives}"
                    SelectedItem="{Binding SelectedDrive}"
                    SelectionChanged="DriveCombo_SelectionChanged"
                    ToolTip="Диск-источник для сбора"
                    AutomationProperties.Name="Диск-источник"
                    AutomationProperties.HelpText="Том, с которого собирать артефакты">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Результаты:" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.TextSecondary}"
                     ToolTip="Каталог, в котором будет создана папка RESULTS"/>
          <TextBox Grid.Column="1" VerticalAlignment="Center"
                   Text="{Binding ResultsPath, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Внутри появится RESULTS\&lt;hostname&gt;\…"
                   AutomationProperties.Name="Папка результатов"
                   AutomationProperties.HelpText="Каталог для папки RESULTS"/>
          <Button Grid.Column="3" Content="Обзор…" Margin="0"
                  Command="{Binding BrowseResultsCommand}"
                  ToolTip="Выбрать папку для результатов"
                  AutomationProperties.Name="Обзор"
                  AutomationProperties.HelpText="Выбрать папку для результатов"/>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="1" Content="Оценить объём"
                  Command="{Binding SimulateCommand}"
                  Margin="0,0,8,0"
                  ToolTip="Подсчитать число файлов и объём без копирования"
                  AutomationProperties.Name="Оценить объём"
                  AutomationProperties.HelpText="Подсчитать число файлов и объём без копирования"/>
          <Button Grid.Column="2" Content="Начать сбор"
                  Command="{Binding StartCommand}"
                  Style="{StaticResource PrimaryButton}" Margin="0" Padding="18,8"
                  ToolTip="Запустить полный сбор артефактов"
                  AutomationProperties.Name="Начать сбор"
                  AutomationProperties.HelpText="Запустить полный сбор артефактов"/>
        </Grid>

        <Expander Header="Дополнительно" Margin="0,12,0,0"
                  IsExpanded="{Binding IsAdvancedExpanded}"
                  AutomationProperties.Name="Дополнительно">
          <StackPanel Margin="0,10,0,0">
            <CheckBox Content="Сначала оценить объём, затем спросить"
                      IsChecked="{Binding SimBeforeCollect}"
                      ToolTip="Перед копированием сначала оценка объёма и подтверждение"
                      AutomationProperties.Name="Сначала оценить объём, затем спросить"
                      AutomationProperties.HelpText="Перед копированием сначала оценка объёма и подтверждение"/>

            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding IsTwoPhase, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Параметры двухфазного сбора">
              <TextBlock Text="Двухфазный сбор" FontWeight="SemiBold" Margin="0,0,0,6"
                         Foreground="{StaticResource Brush.TextSecondary}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Дело (Case ID):" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding CaseId, UpdateSourceTrigger=PropertyChanged}"
                         ui:Watermark.Text="INC-2026-0142"
                         ToolTip="Идентификатор дела для chain_of_custody.txt"
                         AutomationProperties.Name="Дело (Case ID)"
                         AutomationProperties.HelpText="Идентификатор дела для chain_of_custody.txt"/>
              </Grid>
              <StackPanel Orientation="Horizontal">
                <CheckBox Content="Без дампа памяти" Margin="0,0,16,0"
                          IsChecked="{Binding SkipMemory}"
                          ToolTip="Фаза 1 без дампа оперативной памяти"
                          AutomationProperties.Name="Без дампа памяти"
                          AutomationProperties.HelpText="Фаза 1 без дампа оперативной памяти"/>
                <CheckBox Content="Только фаза 1" Margin="0,0,16,0"
                          IsChecked="{Binding Phase1Only}"
                          ToolTip="Только оперативный сбор (память, сеть, процессы)"
                          AutomationProperties.Name="Только фаза 1"
                          AutomationProperties.HelpText="Только оперативный сбор"/>
                <CheckBox Content="Только фаза 2"
                          IsChecked="{Binding Phase2Only}"
                          ToolTip="Только дисковый сбор (targets)"
                          AutomationProperties.Name="Только фаза 2"
                          AutomationProperties.HelpText="Только дисковый сбор"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Margin="0,0,0,12" Padding="14,12"
            Background="{StaticResource Brush.SurfacePanel}"
            BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVis}}"
            AutomationProperties.Name="{Binding ErrorTitle}"
            AutomationProperties.HelpText="{Binding ErrorDetail}"
            AutomationProperties.LiveSetting="Assertive">
      <StackPanel>
        <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.Danger}"/>
        <TextBlock Text="{Binding ErrorDetail}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextPrimary}"/>
        <TextBlock Text="Подробности — в журнале. Можно сохранить журнал и закрыть окно."
                   Margin="0,8,0,0" FontSize="12"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   AutomationProperties.Name="Подсказка по ошибке"/>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="4" Text="Журнал"
               Foreground="{StaticResource Brush.TextSecondary}"
               Margin="0,0,0,6" FontSize="12"/>

    <Border Grid.Row="5" Background="{StaticResource Brush.LogBg}"
            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
            CornerRadius="8" Padding="2">
      <!-- Text is not bound: full Text rebinds reset scroll to top (flicker). Append via code-behind. -->
      <TextBox x:Name="LogBox"
               IsReadOnly="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               AcceptsReturn="True"
               BorderThickness="0"
               Background="Transparent"
               Foreground="{StaticResource Brush.TextSecondary}"
               CaretBrush="{StaticResource Brush.TextPrimary}"
               FontFamily="Consolas"
               FontSize="12"
               Padding="12"
               AutomationProperties.Name="Журнал сбора"
               AutomationProperties.HelpText="Подробный журнал подготовки и сбора"/>
    </Border>

    <DockPanel Grid.Row="6" Margin="0,14,0,0" LastChildFill="False"
               AutomationProperties.Name="Действия после сбора">
      <Button Content="Открыть RESULTS" Command="{Binding OpenResultsCommand}"
              DockPanel.Dock="Left"
              ToolTip="Открыть папку RESULTS с результатами сбора"
              AutomationProperties.Name="Открыть RESULTS"
              AutomationProperties.HelpText="Открыть папку RESULTS с результатами сбора"/>
      <Button Content="Сохранить журнал…" Command="{Binding SaveLogCommand}"
              DockPanel.Dock="Left"
              ToolTip="Сохранить журнал в текстовый файл"
              AutomationProperties.Name="Сохранить журнал"
              AutomationProperties.HelpText="Сохранить журнал в текстовый файл"/>
      <Button Content="Закрыть" Click="Close_Click"
              IsEnabled="{Binding CanClose}"
              DockPanel.Dock="Right" Margin="0"
              ToolTip="Закрыть окно"
              AutomationProperties.Name="Закрыть"
              AutomationProperties.HelpText="Закрыть окно"/>
    </DockPanel>
  </Grid>
</Window>
